# Rate Limit Router — Environment Variables

# OpenCode Zen API key (primary provider)
ZEN_API_KEY=your-opencode-zen-api-key

# OpenRouter API key (fallback provider)
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: path to config.json (default: ./config.json)
# RATE_LIMIT_CONFIG=/path/to/config.json
