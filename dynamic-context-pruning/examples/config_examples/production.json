{
  "thresholds": {
    "hard_limit": 128000,
    "pre_rot_threshold": 60000,
    "compaction_trigger": 80000,
    "summarization_trigger": 100000
  },
  "compaction": {
    "strategy": "hybrid",
    "keep_recent_full": 3,
    "compact_ratio": 0.65,
    "importance_weights": {
      "user_goals": 1.0,
      "errors": 0.95,
      "key_decisions": 0.85,
      "tool_outputs": 0.4,
      "intermediate_steps": 0.2
    }
  },
  "summarization": {
    "schema": "agent_default",
    "keep_recent_full": 2,
    "model": "opencode/big-pickle"
  },
  "offloading": {
    "base_path": ".agent_context",
    "compression": "gzip",
    "index_format": "jsonl"
  },
  "kv_cache": {
    "enforce_stable_prefix": true,
    "append_only": true,
    "deterministic_json": true
  }
}
