# Dynamic Context Pruning — Environment Variables
# These are optional. The core skill works without any API keys.
# Only needed if using external LLM for summarization.

# OpenAI (for summarization model)
OPENAI_API_KEY=your-openai-api-key

# Or use a local model (no key needed)
# SUMMARIZATION_MODEL=gpt-4o-mini
# SUMMARIZATION_BASE_URL=https://api.openai.com/v1
